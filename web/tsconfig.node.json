// 🔴 DO NOT ADD `"composite": true` TO THIS PROJECT EITHER. The measured argument
// is in tsconfig.app.json's header; it applies to every project tsconfig.json
// references, because `tsc -b` decides per project and the poisoning only needs
// one of them.
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["vite.config.ts"]
}
