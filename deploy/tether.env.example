# tether.env.example — EnvironmentFile= for deploy/tether.service.
#
# This file HOLDS A SECRET (TETHER_TOKEN) once filled in. Do not commit a
# filled-in copy anywhere. To use it:
#
#   sudo mkdir -p /etc/tether
#   sudo install -m 0600 -o root -g root deploy/tether.env.example /etc/tether/env
#   sudo -e /etc/tether/env      # then fill in TETHER_TOKEN
#
# Use `install -m 0600`, not `cp` followed by `chmod`: the cp form leaves the
# file world-readable at your umask for the moment in between, which is
# exactly long enough to matter for a file whose whole job is holding a
# secret.
#
# systemd EnvironmentFile= syntax gotchas (this is NOT a shell script, even
# though it looks like one):
#   - One `KEY=value` per line. No `export KEY=value`, no shell expansion,
#     no command substitution.
#   - Quotes are taken LITERALLY: `TETHER_TOKEN="abc"` sets the value to the
#     four characters `"abc"`, including the quote marks — do not quote
#     values unless you actually want the quote characters in the value.
#   - Trailing whitespace matters to systemd's own parser (a trailing space
#     becomes part of the value). tether additionally guards against this
#     itself: TETHER_TOKEN is TrimSpace'd before use, and a value that is
#     only whitespace after trimming counts as unset and falls through to
#     the next precedence level below.
#   - Lines starting with `#` are comments; blank lines are ignored.

# TETHER_TOKEN — static access token for the daemon. FILL THIS IN.
#
# Precedence (highest wins): --token flag > TETHER_TOKEN env (this file) >
# ~/.tether/access-token file > freshly generated on first run.
#
# Generate one:
#   openssl rand -hex 32
# and paste it below. Use that much entropy: this single credential is
# equivalent to a shell on this machine as the service user (the daemon
# drives a coding agent with that user's privileges), it never expires, and
# /api/v1/auth/verify is not rate-limited.
#
# Pre-provisioning is RECOMMENDED for the systemd path rather than merely
# allowed. If you leave this empty, tether takes the generate-on-first-run
# path, which prints the new token once — and under systemd, "print" means
# the journal. deploy/tether.service sets StandardOutput=null to stop that,
# which in turn means you would never see the printed copy at all and would
# have to read it out of $HOME/.tether/access-token. Filling this in avoids
# the whole question.
TETHER_TOKEN=

# TETHER_HOST — the hostname or IP that BROWSERS use to reach this box.
# REQUIRED for any non-loopback access.
#
# This is not cosmetic. tether keeps a browser-origin allowlist of
# 127.0.0.1, localhost and TETHER_HOST (internal/server/mux.go,
# originAllowed). Every non-safe-method request whose Origin is not on that
# list is rejected with `403 forbidden: origin not allowed` — and that
# includes the login POST to /api/v1/auth/verify and the WebTransport
# handshake. So with TETHER_HOST unset, a remote browser loads the page fine
# over HTTPS (GET is a safe method) and then cannot log in, ever. It is a
# hard failure that presents as a soft one. TETHER_HOST is also the OAuth
# issuer host and the hostname in the startup log URL.
#
# Set it to exactly what appears in the browser's address bar, with no
# scheme and no port (e.g. tether.example.com, or 198.51.100.7).
#
# Shipped EMPTY on purpose: empty means unset, so tether keeps its
# 127.0.0.1 default, which is correct and safe for a loopback-only install.
# A shipped example IP would be worse than nothing — it looks configured, so
# nobody edits it, and then it fails in exactly the way described above.
TETHER_HOST=

# --- Optional overrides below — uncomment and edit as needed. ---

# Idle time before a per-task MCP instance is hibernated (Go duration
# string, e.g. "30m"; "0" disables the watchdog entirely). Default: 15m.
# TETHER_MCP_IDLE_TIMEOUT=30m

# Set to "1" to skip PreToolUse hook injection into
# ~/.config/claude/settings.json (this also means every tool call is
# auto-allowed — only use this if you understand that tradeoff, e.g. in a
# throwaway/CI environment). Default: unset.
# TETHER_NO_PERMISSION_HOOK=1

# aihub base URL backing the read-only Work-view proxy. Leave unset to
# disable that proxy (GET /api/v1/work/* then answers 503; the rest of the
# daemon is unaffected). Falls back to ~/.polyforge/config.toml [server].url
# for the service user's HOME if unset here.
# TETHER_AIHUB_URL=https://aihub.example.internal

# aihub API key for the Work-view proxy above — THIS IS ALSO A SECRET, sent
# server-side only as `Authorization: Bearer`, never forwarded to the
# browser. Falls back to ~/.polyforge/config.toml [auth].api_key if unset
# here.
# TETHER_AIHUB_KEY=REPLACE_WITH_REAL_AIHUB_KEY
